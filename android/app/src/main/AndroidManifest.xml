<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cyberbox.ai"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- Permissions required for flexible storage, internet, and execution -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!-- Pure Native C++ / NativeActivity: hasCode="false" specifies zero Java bytecode required -->
    <application
        android:label="@string/app_name"
        android:hasCode="false"
        android:requestLegacyExternalStorage="true"
        android:extractNativeLibs="true">

        <activity
            android:name="android.app.NativeActivity"
            android:label="@string/app_name"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density"
            android:exported="true">
            
            <!-- Tell NativeActivity which C++ shared library (.so) to load -->
            <meta-data
                android:name="android.app.lib_name"
                android:value="cyberbox_native" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
